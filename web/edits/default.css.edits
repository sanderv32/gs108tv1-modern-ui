/* data tables */
body:not(.ui) .messageTableHeader,body:not(.ui) .messageTableHeaderBorder,body:not(.ui) .messageMiddleTableHeader,body:not(.ui) .messageMiddleTableHeaderBorder,body:not(.ui) .cosTableHeader,body:not(.ui) .tableField2{
  background:var(--head)!important;color:var(--muted)!important;border:0!important;border-bottom:1px solid var(--border)!important;padding:8px 10px!important;vertical-align:middle}
body:not(.ui) .white10Bold,body:not(.ui) .white10Bold td{color:var(--muted)!important;font-size:12px!important;font-weight:600!important}
body:not(.ui) tr#editRow td{background:var(--editrow)!important}
body:not(.ui) .messageTableWhite,body:not(.ui) .messageTableWhiteBorder,body:not(.ui) .cosMessageTableWhite,body:not(.ui) .messageMiddleTableWhite,body:not(.ui) .messageMiddleTableWhiteBorder,body:not(.ui) .cosMessageMiddleTableWhite{
  background:var(--surface)!important;border:0!important;border-bottom:1px solid var(--line)!important;padding:7px 10px!important}
body:not(.ui) .messageTableGrey,body:not(.ui) .messageTableGreyBorder,body:not(.ui) .cosMessageTableGrey,body:not(.ui) .messageMiddleTableGrey,body:not(.ui) .messageMiddleTableGreyBorder{
  background:var(--alt)!important;border:0!important;border-bottom:1px solid var(--line)!important;padding:7px 10px!important}
body:not(.ui) table:has(> tbody > tr > td.messageTableHeaderBorder),body:not(.ui) table:has(> tbody > tr > td.messageMiddleTableHeader){border:1px solid var(--border);border-radius:8px;border-collapse:separate;border-spacing:0;overflow:hidden}
/* row highlight used by the selection scripts (they set these colours inline) */
body:not(.ui) tr[style*="background"] td{background:var(--sel)!important}
/* form controls */
body:not(.ui) input[type=text],body:not(.ui) input[type=password],body:not(.ui) input.input,body:not(.ui) input.readonlystyle,body:not(.ui) input.inputDisabled,body:not(.ui) select{
  height:28px;padding:0 8px;border:1px solid var(--border);border-radius:6px;font:13px system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--text);background:var(--surface);box-sizing:border-box}
body:not(.ui) input:focus,body:not(.ui) select:focus{outline:2px solid var(--accent);outline-offset:-1px;border-color:var(--accent)}
body:not(.ui) input:disabled,body:not(.ui) select:disabled,body:not(.ui) input.inputDisabled{background:var(--bg);color:var(--muted)}
body:not(.ui) input[type=checkbox],body:not(.ui) input[type=radio]{accent-color:var(--accent);width:15px;height:15px;vertical-align:middle}
body:not(.ui) .padding4Top{padding-top:6px!important}
body:not(.ui) .mainContainer,body:not(.ui) table{box-sizing:border-box}
body:not(.ui) .mainBody{overflow-x:auto}
.ui .empty{margin:8px 2px;color:var(--muted)}
.ui .empty[hidden]{display:none}
/* inline "Go" image buttons (go to interface) -> text button */
body:not(.ui) a:has(> img[src$="go_on.gif"]){display:inline-flex;align-items:center;justify-content:center;height:28px;padding:0 12px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);font-weight:600;text-decoration:none}
body:not(.ui) a:has(> img[src$="go_on.gif"]):hover{background:var(--head)}
body:not(.ui) a:has(> img[src$="go_on.gif"])::after{content:"Go"}
body:not(.ui) a > img[src$="go_on.gif"]{display:none}
body:not(.ui) .spacerHeight9,body:not(.ui) .spacerHeight21,body:not(.ui) .spacerHeight5{height:4px!important;font-size:0;line-height:0}
/* LAG / VLAN membership: header bar, unit bar, image-based port toggles */
body:not(.ui) .cosTableHeaderText,body:not(.ui) .cosTableHeaderBorderText{background:var(--head)!important;color:var(--muted)!important;border:0!important;border-bottom:1px solid var(--border)!important;padding:8px 10px!important;font-weight:600}
body:not(.ui) .orangeBg{background:var(--head)!important;border-bottom:1px solid var(--border);padding:6px 10px!important}
body:not(.ui) .blue10Bold,body:not(.ui) .blue10Bold a{color:var(--text)!important;font-weight:600;text-decoration:none}
body:not(.ui) img[src$="arrow_blue_up.gif"],body:not(.ui) img[src$="arrow_blue_down.gif"]{display:none}
body:not(.ui) tr#unit1{display:table-row!important}
body:not(.ui) #unit1tb td{padding:6px 4px;text-align:center}
body:not(.ui) #unit1tb tr:first-child td{color:var(--muted);font-weight:600;font-size:12px}
