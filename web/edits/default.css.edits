min-width:0;overflow-wrap:anywhere}
.ui .fields>:nth-child(-n+2){border-top:0}
.ui .fields>dt,.ui .fields>label{margin:0;color:var(--muted);font-weight:500;background:var(--alt)}
.ui .fields>dd{margin:0}
.ui input[type=text],.ui input[type=password],.ui select{height:32px;padding:0 10px;border:1px solid var(--border);border-radius:6px;font:inherit;color:inherit;background:var(--surface);max-width:100%}
.ui input[type=text]:focus,.ui select:focus{outline:2px solid var(--accent);outline-offset:-1px;border-color:var(--accent)}
.ui .hint{margin-left:8px;color:var(--muted);font-size:12px}
.ui .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px}
.ui table.grid{width:100%;border-collapse:separate;border-spacing:0;border:1px solid var(--border);border-radius:8px;overflow:hidden}
.ui table.grid th,.ui table.grid td{padding:9px 14px;c684 39 1
c684 557 1
