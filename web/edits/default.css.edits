text-transform:uppercase;letter-spacing:.04em}
@media (max-width:600px){.ui{padding:14px}.ui .fields{grid-template-columns:1fr}.ui .fields>dd,.ui .fields>input{border-top:0}}
.ui .choices{gap:6px 20px}
.ui .choices label{display:inline-flex;align-items:center;gap:6px;cursor:pointer}
.ui input:disabled{background:var(--bg);color:var(--muted);cursor:not-allowed}

/* ===== Legacy skin: restyles the old (unconverted) pages in the new look ===== */
body:not(.ui){background:var(--surface);color:var(--text);font:13px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;height:auto}
body:not(.ui) td,body:not(.ui) tr,body:not(.ui) table{font-size:13px;font-family:inherit;color:inherit}
body:not(.ui) .mainContainer{padding:20px 24px}
body:not(.ui) .detailsContainer,body:not(.ui) .detailsAreaContainer{width:100%;max-width:980px}
body:not(.ui) .font15Bold{font-size:18px;font-weight:650;color:var(--text);padding:0 0 8px}
body:not(.ui) .font10Bold,body:not(.ui) .font10Bold td{font-size:13px;font-weight:600;color:var(--text)}
body:not(.ui) .font10,body:not(.ui) .font10 td{font-size:13px;font-weight:400}
body:not(.ui) .grey10{color:var(--muted);font-size:12px}
/* section frame: drop the dotted-gif borders, box the content instead */
body:not(.ui) .subSectionBodyDot,body:not(.ui) .subSectionBodyDotRight,body:not(.ui) .subSectionBottom{background:none!important;width:0;padding:0;font-size:0;line-height:0;height:0}
body:not(.ui) .paddingsubSectionBody,body:not(.ui) .paddingsubSectionBodyWide,body:not(.ui) .paddingsubSectionBodyRadio{padding:4px 0 8px!important}
