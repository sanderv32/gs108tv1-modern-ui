body:not(.ui) a:has(> img[name="imx"][src$="_x.gif"])::after{content:"\2713"}
body:not(.ui) a:has(> img[name="imx"][src$="_t.gif"]){background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
body:not(.ui) a:has(> img[name="imx"][src$="_t.gif"])::after{content:"T"}
body:not(.ui) a:has(> img[name="imx"][src$="_u.gif"]){background:var(--ok-strong);border-color:var(--ok-strong);color:var(--on-accent)}
body:not(.ui) a:has(> img[name="imx"][src$="_u.gif"])::after{content:"U"}
body:not(.ui) a:has(> img[name="imx"][src$="_c.gif"]){background:var(--head);color:var(--muted);cursor:not-allowed}
body:not(.ui) a:has(> img[name="imx"][src$="_c.gif"])::after{content:"\2013"}
body:not(.ui) a:not([href]):has(> img[name="imx"]){opacity:.45;cursor:not-allowed}
/* the "all ports" toggle in the unit bar */
body:not(.ui) a:has(> img[name="imx"][src*="orange_"]){width:auto;padding:0 8px;height:24px}
body:not(.ui) a:has(> img[name="imx"][src*="orange_"])::before{content:"All ";font-weight:600;margin-right:4px}
body:not(.ui) .leftNavBg{background:var(--head)!important}
body:not(.ui) td.leftNavBg:empty{display:none}
body:not(.ui) .stormHint{padding:8px 10px!important;color:var(--muted);font-size:12px!important;background:var(--surface)}
/* scripts set inline backgrounds on disabled inputs (#808080); keep the theme colours */
body:not(.ui) input[type=text]:disabled{background:var(--bg)!important}
body:not(.ui) input[type=text]:not(:disabled){background:var(--surface)!important}
.ui .check{display:inline-flex;align-items:center;gap:8px;cursor:pointer}
.ui .warn{margin:12px 0 0;padding:10px 12px;border-radius:6px;background:var(--warn-bg);border:1px solid var(--warn-border);color:var(--warn-text);font-size:13px}
.ui .warn[hidden],.ui .check-result[hidden],.ui .progress[hidden]{display:none}
.ui .check-result{margin:12px 0 0;padding:10px 12px;border-radius:6px;font-size:13px;font-weight:500}
.ui .check-result.good{background:var(--ok-bg);color:var(--ok-text);border:1px solid var(--ok-border)}
.ui .check-result.bad{background:var(--bad-bg);color:var(--bad-text);border:1px solid var(--bad-border)}
.ui form[name=upg] .fields{margin-top:-1px;border-top-left-radius:0;border-top-right-radius:0}
.ui .progress{margin:14px 0 0}
.ui .progress .bar{height:10px;border-radius:5px;background:var(--line);overflow:hidden}
.ui .progress .bar>div{c684 2 1
a684 71
width:0;background:var(--accent);transition:width .3s}
.ui .progress.failed .bar>div{background:var(--bad-text)}
.ui .progress p{margin:6px 0 0;color:var(--muted);font-size:13px}
/* row selection (old scripts add " selectedRow" to cells); last so it beats the row backgrounds */
body:not(.ui) .selectedRow,body:not(.ui) tr.selectedRow td{background:var(--sel)!important;color:var(--text)!important}
/* result / progress pages (fdload.cgi, cdload.cgi, ...) */
.ui .btn{display:inline-flex;align-items:center;justify-content:center;height:34px;padding:0 16px;margin-top:14px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);font:inherit;font-weight:600;cursor:pointer}
.ui .btn:hover{background:var(--bg)}
.ui .btn.primary{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.ui .btn:disabled{opacity:.45;cursor:default}
.ui .status-line{display:flex;align-items:center;gap:10px;margin:4px 0 0;color:var(--muted)}
.ui .spinner{width:16px;height:16px;border:2px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.ui .fields .btn{margin:0 0 0 12px;height:30px}
