/* ===== Theme tokens (light default; dark via html[data-theme=dark], set by rollover.js) ===== */
:root{--bg:#f4f6f9;--surface:#fff;--alt:#fafbfc;--head:#f4f6f9;--editrow:#f7f9fc;--line:#eef1f5;--border:#dde2ea;
  --text:#1d2533;--muted:#647084;--accent:#2563eb;--accent-strong:#1d4ed8;--accent-soft:#e8effd;--on-accent:#fff;--sel:#e8effd;
  --ok-strong:#16a34a;--ok-bg:#ecfdf3;--ok-text:#067647;--ok-border:#abefc6;
  --bad-bg:#fef3f2;--bad-text:#b42318;--bad-border:#fecdca;--warn-bg:#fffaeb;--warn-text:#7a2e0e;--warn-border:#fedf89}
html[data-theme=dark]{color-scheme:dark;--bg:#0f1419;--surface:#171c24;--alt:#1b212a;--head:#1f2630;--editrow:#1a2029;--line:#262d38;--border:#323b48;
  --text:#e6e9ef;--muted:#98a2b3;--accent:#5b8cff;--accent-strong:#7aa2ff;--accent-soft:#1f2b46;--on-accent:#fff;--sel:#1f2b46;
  --ok-strong:#22c55e;--ok-bg:#0f2a1c;--ok-text:#6ee7a8;--ok-border:#1d4d33;
  --bad-bg:#2d1416;--bad-text:#ff8a80;--bad-border:#5c2326;--warn-bg:#2b2210;--warn-text:#f5c76a;--warn-border:#5a4516}
html[data-theme=dark] body{background:var(--surface)}
/* old pages: classes the original sheet colours explicitly */
body:not(.ui) a{color:var(--accent)}

/* ===== New UI (pages with <body class="ui">) ===== */
.ui{margin:0;padding:20px 24px;background:var(--surface);color:var(--text);font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;height:auto}
.ui *{box-sizing:border-box}
.ui h1{margin:0 0 4px;font-size:18px;font-weight:650}
.ui .lead{margin:0 0 20px;color:var(--muted)}
.ui section{margin:0 0 24px}
.ui h2{display:flex;align-items:center;gap:8px;margin:0 0 10px;font-size:13px;font-weight:650;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
.ui .help{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;border:1px solid var(--border);color:var(--muted);c684 23 1
a684 1
font-weight:700;c684 242 1
a684 21
text-transform:none;letter-spacing:0}
.ui .help:hover{color:var(--accent);border-color:var(--accent)}
.ui .fields{display:grid;grid-template-columns:minmax(140px,200px) 1fr;border:1px solid var(--border);border-radius:8px;overflow:hidden}
.ui .fields>*{display:flex;align-items:center;flex-wrap:wrap;padding:9px 14px;border-top:1px solid var(--line);c684 557 1
