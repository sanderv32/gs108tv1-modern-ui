/* Theme (auto/light/dark), shared by every page that loads this file. The choice lives in
   localStorage "gs108t-theme"; colours are the tokens at the top of the new part of default.css. */
function gsTheme(){var t="auto";try{t=localStorage.getItem("gs108t-theme")||"auto"}catch(e){}
 if(t=="auto")t=(window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches)?"dark":"light";
 document.documentElement.setAttribute("data-theme",t);return t;}
gsTheme();
// The content frame's window (IE had document.frames("maincontent")); inside that frame it is the page itself.
function mainFrame(){ return (top.frames && top.frames["maincontent"]) || window; }
