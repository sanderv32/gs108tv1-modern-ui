.venv

# build output (./build.sh recreates it)
build/

# dev server debug output (tools/devserver.py --dump)
devserver-dumps/

# firmware backups from the switch; Netgear's firmware, not to be redistributed
tftp_root/

# Python
__pycache__/
*.pyc

# Ghidra runtime noise
ghidra/**/application.log
*.lock
*.lock~

# Ghidra UI state (window layout, preferences); rewritten every session
ghidra/ghidra_11.4.2_PUBLIC/FrontEndTool.xml
ghidra/ghidra_11.4.2_PUBLIC/preferences
ghidra/ghidra_11.4.2_PUBLIC/tools/_code_browser.tcd

# Ghidra project: contains the decompiled Netgear firmware, not to be redistributed
gs108t.gpr
gs108t.rep/

# Netgear's stock firmware, vendor download and original web dump; not to be redistributed
GS108T-V3.0.4.10.bin
GS108Tv1 Firmware Version 3.0.4.10.zip
ReleaseNotes_GS108Tv1_fw_3.0.4.10.html
web_extracted/
